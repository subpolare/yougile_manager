# Required real credentials
YOUGILE_COMPANY_ID=00000000-0000-0000-0000-000000000000
YOUGILE_API_KEY=replace-with-yougile-api-key
TELEGRAM_BOT_TOKEN=123456789:replace-with-telegram-bot-token

# Employee mappings are discovered generically by their shared prefix.
# *_YG=unknown means no known YouGile user ID. Invalid/empty *_TG values are ignored.
IVAN_TG=@ivan_example
IVAN_YG=11111111-1111-1111-1111-111111111111
MARIA_TG=
MARIA_YG=22222222-2222-2222-2222-222222222222
UNKNOWN_PERSON_TG=@unknown_example
UNKNOWN_PERSON_YG=unknown

# Optional Docker Compose database overrides (safe development defaults are built in).
MYSQL_DATABASE=yougile_bot
MYSQL_USER=yougile
MYSQL_PASSWORD=yougile_dev
MYSQL_ROOT_PASSWORD=yougile_root_dev

# Optional application settings
YOUGILE_BASE_URL=https://yougile.com/api-v2
LOG_LEVEL=INFO
DB_CONNECT_ATTEMPTS=30
DB_CONNECT_RETRY_SECONDS=2

# Reserved for future routing; ignored by this MVP.
TELEGRAM_CHAT_EDITORS=
TELEGRAM_CHAT_EDITING=
TELEGRAM_CHAT_MANAGERS=


# Personal voice reminders (official OpenAI API; never commit the real key).
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_REMINDER_MODEL=gpt-5.6-luna
OPENAI_ERROR_MODEL=gpt-5.6-terra
# Optional numeric Telegram ID for @subpolare, useful before any private interaction.
# ERROR_ADMIN_TELEGRAM_USER_ID=

# Private voice task drafts use existing SASHA_TG / SASHA_YG and VLAD_TG / VLAD_YG pairs.
# Fixed projects: SASHA -> ONLY Саша, VLAD -> ONLY Влад; column Задачи из бота.
# No Telegram numeric ID or username is hardcoded; tasks have assigned: [].
